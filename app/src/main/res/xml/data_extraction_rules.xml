<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer only Cuisine's own data; the face index is rebuilt on the new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="cuisine.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="cuisine.json" />
    </device-transfer>
</data-extraction-rules>
